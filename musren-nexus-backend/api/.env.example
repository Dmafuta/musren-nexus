APP_NAME="Musren Connect"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://musren.quantumconnect.africa

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=musren_prod
DB_USERNAME=postgres
DB_PASSWORD=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://hojqiymudpnjyyqeqvrl.supabase.co
SUPABASE_JWT_SECRET=          # Project Settings → API → JWT Secret
SUPABASE_SERVICE_ROLE_KEY=    # Project Settings → API → service_role key

# ── M-Pesa Daraja ─────────────────────────────────────────────────────────────
MPESA_ENV=production           # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=               # Business shortcode (STK Push + B2C)
MPESA_PASSKEY=                 # STK Push passkey from Daraja portal
MPESA_INITIATOR_NAME=          # B2C initiator username
MPESA_SECURITY_CREDENTIAL=     # Encrypted initiator password (base64)
MPESA_STK_CALLBACK_URL=https://musren.quantumconnect.africa/api/webhooks/mpesa/stk/callback
MPESA_B2C_RESULT_URL=https://musren.quantumconnect.africa/api/webhooks/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://musren.quantumconnect.africa/api/webhooks/mpesa/b2c/timeout

# ── Africa's Talking ─────────────────────────────────────────────────────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=MUSREN

# ── Mail (Resend recommended) ─────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=                 # Resend API key (re_...)
MAIL_FROM_ADDRESS=noreply@musren.co.ke
MAIL_FROM_NAME="Musren Connect"

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://musren.quantumconnect.africa
FRONTEND_URL=https://musren.quantumconnect.africa

# ── App config ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@musren.co.ke
